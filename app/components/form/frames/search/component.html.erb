<div data-controller="calendar frame-search">
  <div class="flex justify-center mb-2">
    <div class="mx-auto">
      <div data-calendar-target="cal"></div>
    </div>
  </div>
  <div class="flex justify-start">
    <table class="table table-bordered table-rounded">
      <tbody>
        <tr>
          <td colspan="2">
            <div class="tooltip tooltip-top" data-tip="タグ or 名前 or 撮影/登録/更新日">
              <input type="text" name="word" id="word" value="" placeholder="" autocomplete="off"
                     class="input input-bordered w-60"
                     data-calendar-target="word" data-frame-search-target="word"
                     data-action="input-&gt;frame-search#clearWordMessage calendar#change">
            </div>
            <div data-frame-search-target="wordMessage" class="text-red-500 text-xs"></div>
          </td>
        </tr>
        <tr>
          <td class="w-[6em]">
            <label for="tag_name">タグ：</label>
          </td>
          <td>
            <input type="text" name="tag_name" id="tag_name" value="" placeholder="" autocomplete="off"
                   class="input input-bordered w-40"
                   data-frame-search-target="tag"
                   data-action="input-&gt;frame-search#clearTagMessage">
            <div data-frame-search-target="tagMessage" class="text-red-500 text-xs"></div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <%= form_with url: root_path, local: true, method: :get, html: { data: { action: "submit->frame-search#submit" } } do |form| %>
    <div class="flex justify-start pt-2">
      <%= form.submit "検索", class: "btn btn-outline btn-primary", name: nil %>
    </div>
  <% end %>
</div>
